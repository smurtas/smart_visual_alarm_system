    {
        "id": "75b60628bdf374f0",
        "type": "function",
        "z": "7da4aa3df36a453a",
        "name": "person photo",
        "func": "const data =\n    typeof msg.payload === \"string\"\n        ? JSON.parse(msg.payload)\n        : msg.payload;\n\nif (data.class !== \"person\") {\n    return null;\n}\n\nconst confidence = Math.round(data.confidence * 100);\n\nmsg.payload = {\n    chatId: \"YOUR_CHAT_ID\",\n    type: \"photo\",\n    content: \"/home/pi/Desktop/Smart-Visual-Alarm-System/runtime/images/latest.jpg\",\n    caption: \n        `🚨 Person detected\\n` +\n        `Confidence: ${confidence}%\\n` +\n        `Time: ${new Date().toLocaleString(\"it-IT\")}`\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
